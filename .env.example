# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SECRET_KEY=your-jwt-secret-key
EXPIRES_IN=6d

# ── Email Service ──────────────────────────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_PORT=587

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ── Google Cloud ─────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Manually place secret.json on the server (do not commit it!)
GOOGLE_APPLICATION_CREDENTIALS=./secret.json
GCP_API_HOST=us-central1-aiplatform.googleapis.com

# ── CORS ─────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── CockroachDB ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# ── Google Cloud Storage (RAG chunk text) ────────────────────────────────────────
GCS_BUCKET_NAME=your-bucket-name

# ── Vertex AI Vector Search (RAG) ────────────────────────────────────────────────
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_ENDPOINT_ID=
VECTOR_SEARCH_DEPLOYED_INDEX_ID=
VECTOR_SEARCH_PUBLIC_ENDPOINT_DOMAIN=
