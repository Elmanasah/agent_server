        {
            "name": "Usage (User + Admin)",
            "description": "Usage quota tracking. GET /me for any logged-in user. All /admin/* routes require admin role.",
            "item": [
                {
                    "name": "Get My Usage",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/usage/me",
                            "host": ["{{baseUrl}}"],
                            "path": ["usage", "me"]
                        },
                        "description": "Returns the current user's quota usage summary: plan, counters, limits, next reset."
                    }
                },
                {
                    "name": "Admin — Get User Usage",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/usage/admin/:userId",
                            "host": ["{{baseUrl}}"],
                            "path": ["usage", "admin", ":userId"],
                            "variable": [{"key": "userId", "value": "<user-uuid>"}]
                        },
                        "description": "Admin: view usage summary for any user."
                    }
                },
                {
                    "name": "Admin — Change User Plan",
                    "request": {
                        "method": "PATCH",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"plan\": \"pro\"\n}",
                            "options": {"raw": {"language": "json"}}
                        },
                        "url": {
                            "raw": "{{baseUrl}}/usage/admin/:userId/plan",
                            "host": ["{{baseUrl}}"],
                            "path": ["usage", "admin", ":userId", "plan"],
                            "variable": [{"key": "userId", "value": "<user-uuid>"}]
                        },
                        "description": "Admin: assign a different plan to a user. Plan must exist in the plans table."
                    }
                },
                {
                    "name": "Admin — Reset User Counters",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/usage/admin/:userId/reset",
                            "host": ["{{baseUrl}}"],
                            "path": ["usage", "admin", ":userId", "reset"],
                            "variable": [{"key": "userId", "value": "<user-uuid>"}]
                        },
                        "description": "Admin: manually reset a user's usage counters to zero."
                    }
                },
                {
                    "name": "Admin — Lock User Account",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reason\": \"Exceeded payment threshold\"\n}",
                            "options": {"raw": {"language": "json"}}
                        },
                        "url": {
                            "raw": "{{baseUrl}}/usage/admin/:userId/lock",
                            "host": ["{{baseUrl}}"],
                            "path": ["usage", "admin", ":userId", "lock"],
                            "variable": [{"key": "userId", "value": "<user-uuid>"}]
                        },
                        "description": "Admin: billing-lock a user's account. All subsequent requests from this user will receive 403."
                    }
                },
                {
                    "name": "Admin — Unlock User Account",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/usage/admin/:userId/unlock",
