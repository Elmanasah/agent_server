        {
            "name": "Plans (Admin)",
            "description": "CRUD for usage plans. All routes require admin role. Plans control resource limits for all users.",
            "item": [
                {
                    "name": "Get All Plans",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/plans",
                            "host": ["{{baseUrl}}"],
                            "path": ["plans"]
                        },
                        "description": "Returns all usage plans ordered by name."
                    }
                },
                {
                    "name": "Get Plan by Name",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/plans/:name",
                            "host": ["{{baseUrl}}"],
                            "path": ["plans", ":name"],
                            "variable": [{"key": "name", "value": "free"}]
                        },
                        "description": "Returns a single plan by its planName (e.g. 'free', 'pro', 'enterprise')."
                    }
                },
                {
                    "name": "Create Plan",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"planName\": \"starter\",\n  \"imageLimit\": 50,\n  \"videoLimit\": 20,\n  \"apiCallLimit\": 500,\n  \"documentLimit\": 100,\n  \"resetPeriod\": \"monthly\"\n}",
                            "options": {"raw": {"language": "json"}}
                        },
                        "url": {
                            "raw": "{{baseUrl}}/plans",
                            "host": ["{{baseUrl}}"],
                            "path": ["plans"]
                        },
                        "description": "Admin: create a new usage plan. resetPeriod must be 'daily' or 'monthly'."
