                            "options": {"raw": {"language": "json"}}
                        },
                        "url": {
                            "raw": "{{baseUrl}}/plans/:name",
                            "host": ["{{baseUrl}}"],
                            "path": ["plans", ":name"],
                            "variable": [{"key": "name", "value": "pro"}]
                        },
                        "description": "Admin: update limits or resetPeriod for an existing plan. Only allowed fields: imageLimit, videoLimit, apiCallLimit, documentLimit, resetPeriod."
